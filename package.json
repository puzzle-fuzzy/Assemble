{
  "name": "assemble",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @assemble/desktop dev",
    "server:dev": "ASSEMBLE_DATA_DIR=data/local/server ASSEMBLE_PUBLIC_ORIGIN=http://127.0.0.1:8787 cargo run -p assemble-server -- serve",
    "server:check": "ASSEMBLE_DATA_DIR=data/local/server ASSEMBLE_PUBLIC_ORIGIN=http://127.0.0.1:8787 cargo run -p assemble-server -- check-config",
    "server:account": "ASSEMBLE_DATA_DIR=data/local/server ASSEMBLE_PUBLIC_ORIGIN=http://127.0.0.1:8787 cargo run -p assemble-server -- create-account",
    "server:accounts": "ASSEMBLE_DATA_DIR=data/local/server ASSEMBLE_PUBLIC_ORIGIN=http://127.0.0.1:8787 cargo run -p assemble-server -- list-accounts",
    "acceptance": "bun scripts/acceptance/run.ts",
    "build": "bun run --filter @assemble/desktop build",
    "typecheck": "bun run --filter @assemble/desktop typecheck && bun run typecheck:tools",
    "typecheck:tools": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "icons": "bun scripts/release/generate-icons.ts",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:fmt:write": "cargo fmt --all",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace --no-fail-fast",
    "rust:clippy:windows": "cargo clippy -p assemble-protocol -p assemble-transfer -p assemble-store -p assemble-device -p assemble-schedule --target x86_64-pc-windows-msvc --all-targets -- -D warnings",
    "verify": "bun scripts/verify/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
