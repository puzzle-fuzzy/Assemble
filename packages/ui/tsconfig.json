{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "paths": {
      "@assemble/ui/components": ["./src/components"],
      "@assemble/ui/components/*": ["./src/components/*"],
      "@assemble/ui/lib": ["./src/lib"],
      "@assemble/ui/lib/*": ["./src/lib/*"],
      "@assemble/ui/hooks": ["./src/hooks"],
      "@assemble/ui/hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src"]
}
