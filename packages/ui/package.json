{
  "name": "@assemble/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:server": "bun scripts/build-server.ts",
    "check:server": "bun scripts/build-server.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.78.0",
    "radix-ui": "1.8.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "@assemble/display": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "4.23.0",
    "@tailwindcss/vite": "4.3.5",
    "vite": "8.3.8",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
