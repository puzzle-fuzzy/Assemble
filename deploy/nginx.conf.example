# Assemble 服务端的反向代理。放进 nginx 的 conf.d（或者 sites-available 里做软链），
# 把三处 assemble.example.com 换成你的域名，证书路径按实际改，然后：
#
#   nginx -t && systemctl reload nginx
#
# 服务端本身在 compose 里只监听本机的 8787；TLS 在这里结束。

upstream assemble {
    server 127.0.0.1:8787;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name assemble.example.com;

    ssl_certificate     /etc/letsencrypt/live/assemble.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/assemble.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 上传的是整个文件，单文件上限 100 MB；多留一点给请求头。
    client_max_body_size 110m;

    location / {
        proxy_pass http://assemble;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 边收边转，不在 nginx 的磁盘上再存一份（服务器的磁盘很紧）。
        # 服务端会提前拒绝超限或不合法的上传，并等发送方把话说完，所以这里不会截断它。
        proxy_request_buffering off;
        # 上传与下载都可能持续很久。
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 设备的事件流是一条不结束的长连接，服务端每 15 秒发一次心跳。
    location /v1/events {
        proxy_pass http://assemble;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name assemble.example.com;

    # 除了续证书时的验证，一律转去 HTTPS。
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
